# Used by Compose; these values do not modify Angular's compiled environments.
# Required in production: ghcr.io/<actual-owner>/<actual-repository>:sha-<full-commit>
# No Git remote is configured locally, so the real name cannot be inferred yet.
FRONTEND_IMAGE=
# Loopback keeps access behind your existing Ubuntu reverse proxy.
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=8080
